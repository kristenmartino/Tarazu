# Dependencies
node_modules

# Build output
dist
.next
.vercel

# Secrets
.env
# Trailing * so per-env variants and backups (.env.local.prod-backup,
# .env.local.staging) are covered too — the bare name left those committable,
# which matters because a backup of .env.local holds the same live keys.
# .env.example stays tracked; it carries placeholders, not real values.
.env.local*

# Test + quality artifacts
playwright-report
test-results
coverage/
reports/
.stryker-tmp/
*.log

# Agent scratch — launch.json and settings.local.json are per-machine, and
# worktrees/ holds full checkouts of this repo (see the .claude/** exclusion in
# vitest.config.js, without which every test is collected twice).
.claude/

# macOS
.DS_Store
